# Local development: export these variables in your shell. This file is not automatically loaded.
APP_ENV=development
PUBLIC_URL=http://127.0.0.1:5080
MAIL_MODE=file
# Production: set through Azure Key Vault references/App Service settings.
# APP_ENV=production
# PUBLIC_URL=https://systracker.hbstest.com
# INGEST_HOST=ingest.hbstest.com
