# MAIL_SENDER=systracker@hbstest.com
# ACS_CONNECTION_STRING=<Azure Communication Services secret, supplied through Key Vault>
# SECRET_KEY=<at least 40 random characters; persist across releases>
# DATABASE_URL=mssql+pytds://systracker_app:URL_ENCODED_PASSWORD@SERVER.database.windows.net:1433/systracker
